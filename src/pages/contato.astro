---
import Base from '../layouts/Base.astro';
import Horarios from '../components/Horarios.astro';
import Faq from '../components/Faq.astro';
import Fecha from '../components/Fecha.astro';
import IconWhatsApp from '../components/IconWhatsApp.astro';
import FotoMotivo from '../components/FotoMotivo.astro';
import espelhos from '../assets/espelhos-bandeira.jpg';
import { site, whatsappUrl, telUrl } from '../data/site';
---
<Base titulo="Contato e horários | Barbearia Lauzangeles, Tremembé" descricao="Endereço, telefone, WhatsApp e horários da Barbearia Lauzangeles, na R. Mamud Rahd, 47, Tremembé, São Paulo.">
  <header class="pagina-topo wrap pagina-duas"><div><h1>Contato e horários</h1><p class="lede suave">R. Mamud Rahd, 47, no Tremembé. Chame no WhatsApp para agendar.</p></div><FotoMotivo src={espelhos} alt="Estação de trabalho com espelhos de lâmpadas e a bandeira de São Paulo na parede" /></header>
  <section class="wrap" style="padding-bottom: var(--gap-secao)" aria-label="Como falar e chegar">
    <div class="contato">
      <div>
        <address class="endereco">{site.endereco.linha}</address>
        <p class="suave" style="margin-top:16px;max-width:38ch">Zona Norte de São Paulo, perto de Tucuruvi, Jaçanã e Santana.</p>
        <p style="margin-top:24px;font-size:1.25rem"><a href={telUrl} data-track="click_call">{site.telefone.exibicao}</a></p>
        <div class="acoes">
          <a class="btn" href={whatsappUrl()} data-track="click_whatsapp" target="_blank" rel="noopener noreferrer"><IconWhatsApp />WhatsApp</a>
          <a class="btn btn--claro" href={telUrl} data-track="click_call">Ligar</a>
          <a class="btn btn--claro" href={site.mapsUrl} data-track="click_maps" target="_blank" rel="noopener noreferrer">Abrir rota</a>
          <a class="btn btn--claro" href={site.instagram.url} data-track="click_instagram" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>
      <Horarios />
    </div>
  </section>
  <section class="secao secao--cartao wrap" aria-labelledby="faq-titulo">
    <div class="faq-bloco"><div class="cabeca"><h2 id="faq-titulo">Perguntas frequentes</h2></div>
    <Faq /></div>
  </section>
  <Fecha />
</Base>
