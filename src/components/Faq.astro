---
import { faq } from '../data/site';
---
<div class="faq">
  {faq.map((f, i) => (
    <details open={i === 0} data-reveal style={`--i:${Math.min(i, 4)}`}>
      <summary>{f.pergunta}<svg viewBox="0 0 36 24" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true"><polyline points="2,22 18,5 34,22" /></svg></summary>
      <p class="resp">{f.resposta}</p>
    </details>
  ))}
</div>
